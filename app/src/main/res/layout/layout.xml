<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="152dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/polylogo"
            android:scaleType="fitStart"
            android:adjustViewBounds="true" />

    </LinearLayout>

    <Spinner
        android:id="@+id/model_spinner"
        android:layout_width="350dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_spinner"
        android:paddingHorizontal="4dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias="0.65"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <EditText
        android:id="@+id/input_text"
        android:layout_width="350dp"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_neon_input"
        android:hint="Введите текст для перевода..."
        android:imeOptions="flagNoEnterAction"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:textColor="#FFFFFF"
        android:textColorHint="#999999"
        android:textSize="15sp"
        android:textStyle="normal"
        android:paddingTop="10dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header" />

    <TextView
        android:id="@+id/input_char_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0/2000"
        android:textColor="#777777"
        android:textSize="11sp"
        android:paddingEnd="8dp"
        android:paddingTop="5dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@+id/input_text"
        app:layout_constraintEnd_toEndOf="@+id/input_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:backgroundTint="@color/main"
        android:text="Перевести"
        android:textColor="#000000"
        android:textSize="15sp"
        android:visibility="visible"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toTopOf="@+id/output_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_text"
        app:strokeColor="@color/main"
        app:strokeWidth="0dp" />

    <TextView
        android:id="@+id/output_text"
        android:layout_width="350dp"
        android:layout_height="110dp"
        android:background="@drawable/bg_neon_input"
        android:hint="Здесь появится перевод Вашего текста."
        android:scrollbars="vertical"
        android:textIsSelectable="true"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#999999"
        android:textSize="15sp"
        android:textStyle="normal"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/model_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/downloads_container"
        android:layout_width="350dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintBottom_toTopOf="@+id/translate_menu_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/downloads_connection_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:background="@drawable/bg_neon_card"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/downloads_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:background="@drawable/bg_neon_card"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/downloads_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_neon_card"
                android:padding="14dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Адрес сервера загрузок"
                    android:textColor="@color/main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/setting_server_url"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:inputType="textUri"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textColorHint="#999999"
                        android:background="@drawable/bg_neon_input"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/setting_server_url_button"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="48dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="✓"
                        android:textSize="18sp"
                        android:backgroundTint="@color/main"
                        android:textColor="#000000"
                        android:minWidth="0dp"
                        android:paddingHorizontal="4dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="Адрес будет проверен перед сохранением."
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setting_reset_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:text="Сбросить адрес сервера"
                    android:textColor="@color/main"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:strokeColor="@color/main"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ScrollView
        android:id="@+id/settings_container"
        android:layout_width="350dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintBottom_toTopOf="@+id/translate_menu_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neon_input"
                android:padding="14dp"
                android:text="«Полиглот» — это open-source платформа для перевода, которая превращает пользователей в соавторов продукта. В отличие от закрытых решений, таких как Google Translate, проект позволяет создавать и адаптировать перевод под конкретные задачи, формируя экосистему языковых решений. За счёт open-source модели «Полиглот» имеет потенциал масштабироваться через сообщество и стать инфраструктурным стандартом в области перевода."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Для пользователей"
                android:textColor="@color/main"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_website_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/main"
                android:text="Сайт проекта"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                app:cornerRadius="10dp"
                app:strokeWidth="0dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Для разработчиков "
                android:textColor="@color/main"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_app_repo_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/main"
                android:text="Репозиторий приложения"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                app:cornerRadius="10dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_tools_repo_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/main"
                android:text="Инструментарий разработки"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"
                app:cornerRadius="10dp"
                app:strokeWidth="0dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/translate_menu_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Перевод"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#1A1A1A"
        android:textColor="#FFFFFF"
        app:strokeColor="@color/main"
        app:strokeWidth="1dp"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/downloads_menu_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/downloads_menu_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="Загрузки"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#1A1A1A"
        android:textColor="#FFFFFF"
        app:strokeColor="@color/main"
        app:strokeWidth="1dp"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/translate_menu_button"
        app:layout_constraintEnd_toStartOf="@+id/settings_menu_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_menu_button"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:text="О проекте"
        android:textSize="12sp"
        android:textStyle="bold"
        android:backgroundTint="#1A1A1A"
        android:textColor="#FFFFFF"
        app:strokeColor="@color/main"
        app:strokeWidth="1dp"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/downloads_menu_button"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>