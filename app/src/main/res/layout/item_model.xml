<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#0D0D0D"
    app:strokeColor="@color/main"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_model_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Название модели" />

            <TextView
                android:id="@+id/item_model_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="12sp"
                android:textColor="#777777"
                android:text="0 МБ" />

            <TextView
                android:id="@+id/item_model_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="#888888"
                android:visibility="gone"
                android:text="" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_download_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Скачать"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:backgroundTint="@color/main"
                app:cornerRadius="8dp"
                android:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:id="@+id/item_progress_container">

                <ProgressBar
                    android:id="@+id/item_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="90dp"
                    android:layout_height="5dp"
                    android:max="100"
                    android:progress="1"
                    android:progressTint="@color/main"
                    android:progressBackgroundTint="#333333" />

                <TextView
                    android:id="@+id/item_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11sp"
                    android:textColor="@color/main"
                    android:text="0%" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_delete_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Удалить"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8B0000"
                app:cornerRadius="8dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
